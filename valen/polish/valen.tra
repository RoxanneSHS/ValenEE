@1 = ~A kimże ty jesteś?~

@2 = ~Kim jestem? Dlaczego miałoby cię to interesować? Ale skoro pytasz... jestem Valen. Czy możesz poświęcić chwilkę, aby wysłuchać mojej propozycji?~

@9 = ~Wydajesz się bardzo blada... prawie nienaturalnie blada. Czy jesteś ranna?~

@3 = ~Mam... dość wrażliwą skórę. Prawdopodobnie za dużo czasu spędzam w pomieszczeniach. Jestem tu jednak, by zaoferować ci bardzo korzystną ofertę. Czy zechcesz mnie wysłuchać?~

@4 = ~To całkiem oczywiste, że jesteś wampirem. Dlaczego mam ci zaufać?~

@5 = ~Są o wiele gorsze rzeczy od przymierza z dziećmi nocy, <CHARNAME>. O wiele, wiele gorsze.~
@6 = ~Jeśli dalej będziesz podążać tą ścieżką, dojdzie do tego, że sam<PRO_HESHE> wykopiesz sobie grób. A ja proponuję ci jedynie rozmowę z istotami z niego zrodzonymi.~
@7 = ~Wydajesz się inteligentnym przedstawicielem swojej rasy. Porozmawiaj z moją panią, <CHARNAME>, inaczej możemy kiedyś stać się wrogami.~ ~Wydajesz się inteligentną przedstawicielką swojej rasy. Porozmawiaj z moją panią, <CHARNAME>, inaczej możemy kiedyś stać się wrogami.~
@8 = ~W mieście trwa właśnie wojna gildii, <CHARNAME>, a ty stoisz teraz po stronie przegranych. Spotkaj się z moją panią. Rozważ jej ofertę. Ocal swoje własne życie i to należące do twojej zaginionej przyjaciółki.~

/////////////////////////////////////////////////////////////////////

@20 = ~W każdym razie, jestem gotowa zaoferować ci pewną pomoc. Valen, wierna służka i członek mojej... rodziny... dostała rozkaz towarzyszenia ci w tym zadaniu.~
@21 = ~Jest skora przyłączyć się do twojego małego... polowania... i będzie słuchać twoich rozkazów tak jak moich. Będzie na ciebie czekać, tuż po naszej krótkiej rozmowie.~
@22 = ~Dostała jednak rozkaz, aby opuścić twoją drużynę, jeśli tylko staniecie się... zbyt prawi.~
@23 = ~Skorzystaj z tego, co ma do zaoferowania... albo nie. Po prostu upewnij się, że wykonasz wyznaczone zadanie.~
@24 = ~A co do Złodziei Cienia...~

/////////////////////////////////////////////////////////////////////
@100 = ~Co mogę dla ciebie zrobić, <CHARNAME>?~
  @101 = ~Czym ty w ogóle jesteś, Valen?~
@102 = ~Jak się zapewne domyślasz, jestem jednym z najnowszych... dzieł Bodhi.~
@103 = ~Zanim wciągnęła mnie na łono swej kochającej rodziny, byłam zwykłym rabusiem. Tak jak wielu... ludzi... nie byłam zdolna uczciwie na siebie zarobić na ulicach Athkatli.~
@104 = ~Zeszłam na drogę przestępczą w młodym wieku i spędziłam wiele lat jako zwykły zbir, ćwicząc moje zdolności w posługiwaniu się sztyletem w ciemnych alejach. Nic mnie nie obchodziło poza brutalną siła, i nawet się nie przejmowałam finezją potrzebną do wepchnięcia komuś noża w plecy.~
@105 = ~Tanova znalazła mnie, zanim zrobiła to Straż Miejska, i zaprowadziła mnie do Bodhi. Wydawało się jej, że ujrzała we mnie iskrę talentu.~
@106 = ~Oczywiście, opierałam się. Kiedy pozwolono mi stanąć przed obliczem pani, myślałam tylko o ucieczce.~
@107 = ~Jednak zostałam przez nią obdarta z mych naiwnych przekonań o wolnej woli szybciej, niż słońce rozwiewa poranną mgłę.~
@108 = ~Jednym spojrzeniem przejęła mnie na całe życie... i dłużej. Miała plany dotyczące znienawidzonych Złodziei Cienia. Należy ich zinfiltrować, zakłócić ich działalność. Przejmować ich ludzi.~
@109 = ~Miałam jej służyć w tym zadaniu. Jednak wcześniej musiałam się nauczyć czegoś o życiu łotrzyka.~
@110 = ~Moja pani poleciła mi zostać złodziejką... a ja natychmiast wykonałam jej rozkaz. Dzięki jej złotu i reputacji, w tajemnicy zostałam wyszkolona przez Nocne Noże w pobliskim mieście. Zapomniałam o swoim poprzednim życiu wojowniczki. Zostawiłam je za sobą i nie chciałam do niego wracać.~
@111 = ~Kiedy zobaczyła, jakim złodziejem się stałam, moja pani się rozradowała. Byłam niemalże doskonałym narzędziem. Tamtej nocy zostałam obdarowana jej Pocałunkiem... i wtedy poznałam piękno świata mroku.~
@112 = ~Ludzie, jak się wydaje, są bardziej zaszeregowani według profesji, więc stając się z wojownika złodziejem, muszą się bardziej skupić na byciu tym drugim. Nieumarli są bardziej... wszechstronni... w swoich dążeniach.~
@113 = ~Kiedy się przebudziłam po mojej przemianie, odkryłam, że wiedza o walce powróciła, aby współistnieć z moimi zdolnościami złodziejskimi. Zaczęłam służyć mojej pani jako wsparcie w walce i inwigilacji.~
@114 = ~Wykonałam już wiele zadań, by ją... zadowolić. Jednym z ostatnich było poinformowanie cię o spotkaniu. A teraz stoję przed tobą, aby wykonać jej kolejne życzenie.~
  @121 = ~Co możesz dla mnie zrobić, Valen?~
@122 = ~Pani rozkazała mi przyłączyć się do twojej drużyny i podróżować pod twoimi rozkazami... o ile nie ma wśród twych towarzyszy jakichś obrońców moralności.~
@123 = ~Będę ci służyła jako wojowniczka i... zwiadowczyni. Jestem całkiem zręczna w otwieraniu wszelkich zamków, unikaniu pułapek oraz ukrywaniu się. Radzę też sobie całkiem dobrze w walce.~
@124 = ~Oczywiście to, jak mnie wykorzystasz, zależy jedynie od twoich planów. Mogę badać teren pozostając ukrytą, usuwać wszelkie przeszkody albo zabijać niedoszłych wrogów z ukrycia.~ 
@125 = ~Zapamiętaj jednak, że mam silny... instynkt. Tak, będę wykonywała twoje rozkazy, ale pozostawiona sama sobie nie będę się wahała zabić twoich wrogów albo przygotować się do tego.~ 
@126 = ~Ale mogę robić cokolwiek innego. Możesz też nie przyjąć moich usług, o ile wykonasz rozkazy mojej pani.~
@127 = ~Jeśli już przyjmiesz mnie do drużyny, zapamiętaj jedną ważną rzecz: nie mogę zostać przywrócona do życia, jeśli moje ciało zostanie zniszczone. Śmierć dla nieumarłego jest ostateczna.~

@131 = ~Na razie nic, Valen.~
@141 = ~Przyłącz się do mnie.~
@142 = ~Dobrze, <CHARNAME>. Czas na polowanie!~

@200 = ~Już ze mną skończyłeś, <CHARNAME>?~ ~Już ze mną skończyłaś, <CHARNAME>?~
@201 = ~Moja pomyłka, Valen. Wracaj do drużyny.~
@202 = ~Tak. Na razie tutaj zaczekaj.~

@300 = ~Wybacz mi, <CHARNAME>, ale nie mogę podróżować ze świętym Inkwizytorem Torma. Po prostu uważam, że nic by z tego nie wyszło.~
@301 = ~Przykro mi, <CHARNAME>, ale kapłanka Baervana i ja nie stworzyłybyśmy zgranej drużyny. Dopóki ona z tobą jest, ja nie mogę ci towarzyszyć.~
@302 = ~Wybacz mi, <CHARNAME>, ale nie będę mogła utrzymywać dobrych stosunków z kapłanem Helma. Muszę opuścić twoją drużynę, dopóki ten... Anomen jest z tobą.~
@303 = ~Przykro mi, <CHARNAME>, ale ta święta wojowniczka Arvoreena i ja nie będziemy się dogadywać. Możesz to nazwać przeczuciem. Muszę opuścić drużynę, dopóki ona w niej jest.~

@310 = ~Pani! Służyłam mu, jak sobie tego życzyłaś. Zabierz mnie ze sobą: <CHARNAME> już nie potrzebuje pomocy przeciwko Złodziejom Cienia.~ ~Pani! Służyłam jej, jak sobie tego życzyłaś. Zabierz mnie ze sobą: <CHARNAME> już nie potrzebuje pomocy przeciwko Złodziejom Cienia.~
@311 = ~Zgadza się. Nie ma już Złodziei Cienia. Mój brat ma już wszystkie niezbędne ofiary. I to działa! Już czuję, że odzyskałam duszę.~
@312 = ~Moja droga Valen, to wszystko oznacza, że już więcej cię nie potrzebuję. Najpierw potrzebna mi byłaś do zbadania Złodziei Cienia i dostarczenia odpowiedniej ilości świeżych ciał potrzebnych do rytuału mojego brata. Spisałaś się doskonale. Twoim drugim zadaniem było dopilnowanie, aby <CHARNAME> przeżył<PRO_HESHE>, wykonując nasze drobne... misje.~
@313 = ~I ponownie spisałaś się doskonale. Teraz nie jesteś mi już do niczego potrzebna. Po prostu pozbędę się ciebie, tak jak zrobiłabym to z każdym innym narzędziem.~
@314 = ~Błagam cię, pani, przemyśl to jeszcze raz! Nadal mogę ci się przydać! Moje życie należy do ciebie.~
@315 = ~Biedna Valen. Wcale mnie nie obchodzi, co czujesz i myślisz, a naprawdę nie mam już na to czasu. Głód zaczyna mi coraz bardziej doskwierać, marzę o ekscytującym pościgu. Jeśli naprawdę chcesz mnie zadowolić...~
@316 = ~O tak, Bodhi!~
@317 = ~... zostań z <PRO_SIRMAAM> i walcz u j<PRO_HISHER> boku. Przejdź przez podziemia Czarowięzów i dopilnuj, aby <CHARNAME> dotrwał<PRO_HESHE> do pojedynku ze mną. Podnieś swą rękę przeciwko mnie, Valen, bo tylko podczas walki naprawdę się rozwijamy.~
@318 = ~Twój los jest teraz związany z tym pomiotem Bhaala, moje dziecko. Kiedy się spotkamy następnym razem, mam nadzieję, że poczuję twoje szpony na moim gardle... albo moje na twoim.~
@319 = ~Nie, pani, błagam cię!~
@320 = ~Zamilcz, Valen! Wydałam rozkaz i masz być mu posłuszna. Posłuszna!~
@321 = ~Tak, Bodhi. Moja wola należy do ciebie. Wykonam rozkaz.~
@322 = ~Więc niech się ono zacznie.~

@330 = ~Bodhi, <CHARNAME> wraz ze mną wydostał się z Czarowięzów. Stałam u jego boku w drodze przez Podmrok. Wykonałam twoje polecenie, moja pani. Przyjmij mnie z powrotem.~ ~Bodhi, <CHARNAME> wraz ze mną wydostała się z Czarowięzów. Stałam u jej boku w drodze przez Podmrok. Wykonałam twoje polecenie, moja pani. Przyjmij mnie z powrotem.~
@331 = ~Ach, moja biedna, głupiutka Valen. Powinnaś była czytać między wierszami podczas naszej ostatniej rozmowy. Po tym, jak odzyskałam moją duszę i plan mojego brata został wykonany, już więcej cię nie potrzebuję.~
@332 = ~Odejdź, moja droga niegdyś służko. Jesteś teraz niewarta mojej uwagi.~
@333 = ~Pani! Co pocznę bez ciebie? Nie będę wiedziała, co mam robić.~
@334 = ~Ach! Marnujesz mój czas swoim żałosnymi jękami, podczas gdy krew zaczyna coraz szybciej krążyć mi w żyłach. <CHARNAME> jest tutaj i chcę się pożywić j<PRO_HISHER> krwią.~
@335 = ~Jeśli naprawdę potrzebujesz rozkazu, to nakazuję ci nadal go wspierać. Uczyń tę naszą ostatnią walkę bardziej interesującą dla mnie.~ ~Jeśli naprawdę potrzebujesz rozkazu, to nakazuję ci nadal ją wspierać. Uczyń tę naszą ostatnią walkę bardziej interesującą dla mnie.~
@336 = ~Jak sobie życzysz, pani.~
@337 = ~Doskonale, a teraz zaczynajmy!~

@400 = ~Valen, tajemnicza służka Bodhi, choć nie zdobyła pełni twojego zaufania, stała się ważnym członkiem drużyny.~
@401 = ~Valen, w nadchodzącej bitwie muszę się w pełni skoncentrować na przeciwniku. Nie idź ze mną, jeśli nie mogę całkowicie liczyć na twoją lojalność. To nie pora, abyś ponownie związała swój los z moimi wrogami.~
@402 = ~Valen, to nie jest twoja walka. Teraz, kiedy Bodhi nie żyje, możesz robić cokolwiek tylko chcesz. Jesteś wolna. Nie musisz mi towarzyszyć w walce z tym szalonym magiem.~

@403 = ~Możesz mi ufać, <CHARNAME>. Jestem gotowa na każdy twój rozkaz. Kiedyś było to jedynie życzeniem Bodhi, teraz jest ono mym własnym. Dowiodłeś, że jesteś silniejszy od Bodhi, nieumarłych, a nawet Irenicusa.~ ~Możesz mi ufać, <CHARNAME>. Jestem gotowa na każdy twój rozkaz. Kiedyś było to jedynie życzeniem Bodhi, teraz jest ono mym własnym. Dowiodłaś, że jesteś silniejsza od Bodhi, nieumarłych, a nawet Irenicusa.~
@404 = ~Jak mogłabym nie sprzymierzyć się z taką potęgą? Twoja moc mnie wzywa, przyciąga jak ćmę do światła. Jestem na każdy twój rozkaz, <PRO_LADYLORD>.~

@405 = ~Wolność? Nie rozśmieszaj mnie. Nikt z nas nie jest wolny, <CHARNAME>. Bez Bodhi mam wolność podejmowania decyzji... cóż za wielka odpowiedzialność.~
@406 = ~Wolność nie jest zawsze przyjemna. Kiedy moja wola była zależna od Bodhi, nie miałam żadnych wątpliwości czy dylematów. Jeśli nie pójdę z tobą dalej, co innego będę robiła?~
@407 = ~Mam tułać się po świecie? Utworzyć własny klan wampirów? Nie, jestem istotą czynu, a nie refleksji. Moje miejsce jest przy tobie. Moja krew śpiewa w oczekiwaniu na walkę.~

// Salvanas and Valen
@500 = ~Och, witaj. Dostrzegłem twoje rozkołysane ruchy i musiałem zadać sobie pytanie: „Salvanasie, cóż to za urzekająca istota może posiadać tak intrygujący, nadnaturalny wdzięk?”~
@501 = ~Cóż za istota? Może taka, która z chęcią odebrałoby ci jednocześnie twój dobytek, życie i śmiertelność?~
@502 = ~Moja droga, moje ciało pragnie ostudzić się w twych płynach.~
@503 = ~A ja czuję nagłą potrzebę zaspokojenia mojego apetytu w płynach twoich tętnic. Dość... przytłaczające... pożądanie...~
@504 = ~Hmm... mm... wspaniale, która to już godzina? Muszę uciekać... i to szybko, inaczej spóźnię się na statek!~

// Talk Directly To Valen
@600 = ~Tak, <CHARNAME>?~

@601 = ~Czy mogłabyś przestać próbować ukrywać się?~
@602 = ~Staraj się trzymać poza wzrokiem naszych wrogów.~
@603 = ~Chciał<PRO_HESHE>bym, żebyś przestała atakować wrogów bez mojego rozkazu. Rozumiem, że jest to wbrew twojej naturze, ale nasza walka wymaga więcej subtelności.~
@604 = ~Nadszedł czas na działanie. Masz moje zezwolenie na atakowanie wrogów, kiedy tylko zechcesz.~
@605 = ~Możesz sprawdzić, czy twoje szpony i zbroja są w dobrym stanie?~
@606 = ~Już nic, nieważne.~
@607 = ~Przestań podejmować próby przejęcia kontroli nad umysłami naszych wrogów.~
@608 = ~Zmieniam moje zdanie, używaj swoich mocy na naszych przeciwnikach.~
@609 = ~Nie potrzebuję już, abyś szukała pułapek i sideł, Valen.~
@610 = ~Valen, proszę, miej ponownie oko na pułapki ustawione na naszej drodze.~

@697 = ~O tak! Widzę, <CHARNAME>, że jednak okazujesz trochę rozsądku.~
@698 = ~Nie podoba mi się to, ale zrobię, jak sobie życzysz... do pewnego stopnia. Czasem żądza krwi jest zbyt silna, abym mogła ją zignorować.~
@699 = ~Bardzo dobrze.~

